# Database (PostgreSQL — Neon / Supabase / Vercel Postgres)
DATABASE_URL=

# Auth.js (NextAuth) session config
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Cloudinary (server writes + client-direct signed uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Image processing pipeline limits
MAX_IMAGE_SIZE_MB=10
IMAGE_PROCESSING_MAX_WIDTH=1440

# Trigger.dev durable background jobs.
# Leave empty until connecting: run `npx trigger.dev@latest init` and paste
# the values it generates. Until set, uploads stay `queued` and can be
# processed later via the reprocess endpoint.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Event date for the homepage countdown (ISO 8601 with timezone)
EVENT_DATE=2026-12-31T18:00:00+07:00

# Community uploads open N hours after EVENT_DATE (omit = always open).
# Hides gallery CTAs, top-bar link, /upload, and upload APIs until then;
# the admin console upload is never gated.
# UPLOAD_OPEN_HOURS_AFTER_EVENT=5

# Admin console (/admin) — HTTP Basic Auth
ADMIN_USERNAME=panitia
ADMIN_PASSWORD=change-me-at-least-8-chars
