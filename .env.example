# Database (PostgreSQL — Neon / Supabase / Vercel Postgres)
DATABASE_URL=

# Auth.js (NextAuth) session config
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Vercel Blob (server writes + client-direct upload tokens)
BLOB_READ_WRITE_TOKEN=

# Image processing pipeline limits
MAX_IMAGE_SIZE_MB=10
IMAGE_PROCESSING_MAX_WIDTH=1440

# Trigger.dev durable background jobs.
# Leave empty until connecting: run `npx trigger.dev@latest init` and paste
# the values it generates. Until set, uploads stay `queued` and can be
# processed later via the reprocess endpoint.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Event date for the homepage countdown (ISO 8601 with timezone)
EVENT_DATE=2026-12-31T18:00:00+07:00
