datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JerseySize {
  S
  M
  L
  XL
  Two_XL @map("2XL")
  Three_XL @map("3XL")
  Four_XL @map("4XL")
  Five_XL @map("5XL")
}

enum ClassGroup {
  IPA_1 @map("IPA-1")
  IPA_2 @map("IPA-2")
  IPA_3 @map("IPA-3")
  IPS_1 @map("IPS-1")
  IPS_2 @map("IPS-2")
  IPS_3 @map("IPS-3")
  IPS_4 @map("IPS-4")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ImageStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ImageErrorCategory {
  INVALID_FILE
  UNSUPPORTED_FORMAT
  FILE_TOO_LARGE
  DOWNLOAD_FAILED
  PROCESSING_FAILED
  STORAGE_FAILED
  UNKNOWN
}

enum QuestionnaireQuestionType {
  CHOICE
  SCALE
  TEXT
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts             Account[]
  sessions             Session[]
  registration         Registration?
  galleryImages        Image[]
  imageAssets          ImageAsset[]
  questionnaireAnswers QuestionnaireAnswer[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Registration {
  id                   String             @id @default(cuid())
  userId               String             @unique
  jerseySize           JerseySize
  classGroup           ClassGroup
  phone                String
  bankTransferProofUrl String             @db.Text
  status               VerificationStatus @default(PENDING)
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classGroup])
  @@index([status])
  @@map("registrations")
}

model Image {
  id           String   @id @default(cuid())
  url          String   @db.Text
  title        String?
  description  String?
  userId       String
  imageAssetId String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("images")
}

/// Optimized gallery image pipeline asset (see openspec/changes/feat-image-optimization-pipeline).
/// `variants` JSON shape: { [variant]: { key, url, width, height, size, mime } }
model ImageAsset {
  id            String              @id @default(uuid())
  userId        String
  originalKey   String              @unique
  originalUrl   String?             @db.Text
  originalMime  String?
  originalSize  BigInt?
  status        ImageStatus         @default(QUEUED)
  width         Int?
  height        Int?
  variants      Json?
  errorMessage  String?             @db.Text
  errorCategory ImageErrorCategory?
  jobRunId      String?
  title         String?
  description   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  processedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("image_assets")
}

/// Alumni questionnaire (see openspec/changes/feat-questionnaire).
/// `isOpen` gates submissions, `requireVerified` toggles the registration-
/// verification gate, `resultsPublished` toggles the public stats page.
model Questionnaire {
  id               String   @id @default(cuid())
  title            String
  description      String?
  isOpen           Boolean  @default(false)
  requireVerified  Boolean  @default(true)
  resultsPublished Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions QuestionnaireQuestion[]

  @@map("questionnaires")
}

/// `options` JSON shape per type:
/// - CHOICE: ["1", "2", ...] (custom option values)
/// - SCALE:  {"min": 1, "max": 5}
/// - TEXT:   null
model QuestionnaireQuestion {
  id              String                    @id @default(cuid())
  questionnaireId String
  order           Int                       @default(0)
  type            QuestionnaireQuestionType
  label           String
  description     String?
  options         Json?
  required        Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  questionnaire Questionnaire          @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  answers       QuestionnaireAnswer[]

  @@index([questionnaireId])
  @@map("questionnaire_questions")
}

/// One stored answer per user per question — resubmission overwrites in place
/// (koreksi jawaban). `questionnaireId` is denormalized for stats grouping.
model QuestionnaireAnswer {
  id              String   @id @default(cuid())
  questionnaireId String
  questionId      String
  userId          String
  choiceValue     String?
  numberValue     Int?
  textValue       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  question QuestionnaireQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([questionnaireId, questionId, choiceValue])
  @@index([questionnaireId, questionId, numberValue])
  @@index([questionnaireId, userId])
  @@map("questionnaire_answers")
}
