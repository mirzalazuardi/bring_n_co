datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JerseySize {
  S
  M
  L
  XL
}

enum ClassGroup {
  IPA_1 @map("IPA-1")
  IPA_2 @map("IPA-2")
  IPA_3 @map("IPA-3")
  IPS_1 @map("IPS-1")
  IPS_2 @map("IPS-2")
  IPS_3 @map("IPS-3")
  IPS_4 @map("IPS-4")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ImageStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ImageErrorCategory {
  INVALID_FILE
  UNSUPPORTED_FORMAT
  FILE_TOO_LARGE
  DOWNLOAD_FAILED
  PROCESSING_FAILED
  STORAGE_FAILED
  UNKNOWN
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts      Account[]
  sessions      Session[]
  registration  Registration?
  galleryImages Image[]
  imageAssets   ImageAsset[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Registration {
  id                   String             @id @default(cuid())
  userId               String             @unique
  jerseySize           JerseySize
  classGroup           ClassGroup
  phone                String
  bankTransferProofUrl String             @db.Text
  status               VerificationStatus @default(PENDING)
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classGroup])
  @@index([status])
  @@map("registrations")
}

model Image {
  id          String   @id @default(cuid())
  url         String   @db.Text
  title       String?
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("images")
}

/// Optimized gallery image pipeline asset (see openspec/changes/feat-image-optimization-pipeline).
/// `variants` JSON shape: { [variant]: { key, url, width, height, size, mime } }
model ImageAsset {
  id            String              @id @default(uuid())
  userId        String
  originalKey   String              @unique
  originalUrl   String?             @db.Text
  originalMime  String?
  originalSize  BigInt?
  status        ImageStatus         @default(QUEUED)
  width         Int?
  height        Int?
  variants      Json?
  errorMessage  String?             @db.Text
  errorCategory ImageErrorCategory?
  jobRunId      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  processedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("image_assets")
}
